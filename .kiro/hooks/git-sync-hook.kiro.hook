{
  "enabled": true,
  "name": "Git Sync on File Edit",
  "description": "Automatically syncs code changes with git by staging, committing, and pushing changes when source files are modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "tests/**/*.ts",
      "*.js",
      "*.json",
      "*.md"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "git add . && git commit -m \"Auto-sync: Updated files\" && git push"
  }
}