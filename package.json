{
  "name": "notes-ai-organizer",
  "version": "1.0.0",
  "description": "Multi-agent AI system for Apple Notes organization",
  "author": "Notes AI Organizer Team",
  "main": "electron-main-app.js",
  "scripts": {
    "build": "tsc",
    "build:ios": "react-native run-ios",
    "build:macos": "react-native run-macos",
    "start": "npm run build && node dist/main.js",
    "cli": "npm run build && node dist/cli.js",
    "simple": "npx tsc src/simple-cli.ts --outDir dist --target ES2020 --module CommonJS && node dist/simple-cli.js",
    "macos": "node macos-app.js",
    "demo": "node simple-demo.js",
    "app": "electron electron-main-clean.js",
    "app:dev": "NODE_ENV=development electron electron-main-app.js",
    "app:production": "npm run build && node production-notes-app.js",
    "app:analyze": "npm run build && node production-notes-app.js analyze",
    "app:stats": "npm run build && node production-notes-app.js stats",
    "app:help": "npm run build && node production-notes-app.js help",
    "package:mac": "npm run build && electron-builder --mac",
    "dev": "tsc --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:pbt": "vitest --run --reporter=verbose tests/property",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "type-check": "tsc --noEmit",
    "start:cli": "node dist/cli.js analyze",
    "start:macos": "node dist/macos-app.js",
    "start:web": "python3 -m http.server 8080 --bind 127.0.0.1",
    "start:electron": "electron dist/electron-main.js",
    "app:desktop": "npm run build && electron electron-desktop-app.js",
    "app:web": "npm run build && node app-server.js",
    "app:mobile": "npm run build && node app-server.js",
    "build:mac": "npm run build && electron-builder --mac --publish=never",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@langchain/core": "^1.1.8",
    "@langchain/langgraph": "^1.0.7",
    "@react-native-async-storage/async-storage": "^1.19.0",
    "@react-native-community/netinfo": "^9.4.1",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "langchain": "^1.2.3",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-background-timer": "^2.4.1",
    "react-native-fs": "^2.20.0",
    "react-native-keychain": "^8.1.2",
    "react-native-macos": "^0.72.0",
    "react-native-touch-id": "^4.4.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "eslint": "^8.0.0",
    "fast-check": "^3.15.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.notesai.organizer",
    "productName": "Notes AI Organizer",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "simple-app.html",
      "electron-main-app.js",
      "macos-app.js",
      "build/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
