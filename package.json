{
  "name": "notes-ai-organizer",
  "version": "1.0.0",
  "description": "Multi-agent AI system for Apple Notes organization",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:ios": "react-native run-ios",
    "build:macos": "react-native run-macos",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:pbt": "vitest --run --reporter=verbose tests/property",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-macos": "^0.72.0",
    "@react-native-community/netinfo": "^9.4.1",
    "react-native-fs": "^2.20.0",
    "react-native-keychain": "^8.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "fast-check": "^3.15.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}